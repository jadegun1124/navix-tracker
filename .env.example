# 가족 지도는 VWorld를 쓰므로 이 키는 사용하지 않습니다.
# 예전 Google Maps 연동을 위해 이름만 남겨 둡니다. 저장소에 값을 커밋하지 않습니다.
VITE_GOOGLE_MAPS_API_KEY=

# 국토교통부 VWorld 2D Base 지도 키. https://www.vworld.kr/ 에서 발급합니다.
# 앱은 import.meta.env.VITE_VWORLD_API_KEY 만 읽습니다. 키 값은 커밋하지 않습니다.
# 값이 없으면 가족 지도는 한국어 안내만 보여 주고 타일을 요청하지 않습니다.
#
# 빌드에 키가 들어가는 경로 (셋 중 하나):
# 1. 로컬: 이 파일을 .env 로 복사하고 값을 채운 뒤 npm run dev 또는 npm run build
# 2. GitHub Pages: .github/workflows/deploy.yml 이 secret VITE_VWORLD_API_KEY 를
#    npm run build 환경에 넣습니다. 그 secret이 비어 있으면 VWORLD_API_KEY 를 복사합니다.
# 3. APK: .github/workflows/build-apk.yml 이 같은 방식으로 웹 빌드를 만든 뒤
#    dist 를 안드로이드 에셋으로 복사합니다. secret을 바꾼 뒤에는 main에 푸시해
#    워크플로를 다시 돌려야 Pages와 APK에 반영됩니다. PR 빌드에는 secret이 안 들어갑니다.
#
# 브이월드 인증키 서비스 URL에 아래 주소를 등록합니다.
# - https://jadegun1124.github.io
# - https://localhost          (Capacitor 안드로이드 앱)
# - http://localhost:5173      (로컬 npm run dev)
# - http://127.0.0.1:5173
VITE_VWORLD_API_KEY=

# 다른 폰 위치 동기화 주소. Cloudflare Worker 오리진만 적습니다.
# 공개 Worker: https://umap-family-sync.umap-jadegun.workers.dev
# 로컬 서버는 http://127.0.0.1:8787 (npm run sync).
# 이 주소는 비밀이 아니며 빌드된 앱에 들어갑니다. 읽기 키는 넣지 않습니다.
# 로컬에서 비어 있으면 같은 브라우저의 localStorage 공유만 동작하고, 화면에 그 사실을 알립니다.
# Pages와 APK는 secret이 없어도 위 공개 주소를 기본으로 넣습니다.
# secret VITE_FAMILY_SYNC_URL 이 있으면 그 주소가 기본값을 대신합니다.
# 전화번호는 동기화에 쓰지 않습니다.
VITE_FAMILY_SYNC_URL=

# Google 로그인용 OAuth 웹 클라이언트 ID. 공개 값이며 시크릿이 아닙니다.
# 비어 있거나 예시 값이면 Google 버튼은 한국어 설정 안내만 보여주고 로그인하지 않습니다.
# Android OAuth 클라이언트는 패키지 kr.co.umap.tracker, SHA-1은 umap-sideload.keystore 입니다.
# 승인된 자바스크립트 원본: https://localhost , http://localhost:5173
# 값은 커밋하지 않습니다. Pages와 APK는 secret VITE_GOOGLE_WEB_CLIENT_ID 를 빌드에 넣습니다.
VITE_GOOGLE_WEB_CLIENT_ID=
